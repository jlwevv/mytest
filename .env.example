# GPS point to search around
LAT=38.8894
LON=-77.0352

# Distance units for the report: miles, km, or knots (nautical miles)
UNITS=miles

# Precip rate units for the report: mm (mm/hr) or in (in/hr)
RATE_UNITS=in

# Minutes of radar history to look back when estimating storm motion.
# Larger = smoother/more stable estimate but slower cold-cache backfill;
# smaller = more responsive but noisier.
LOOKBACK_MIN=30

# Minutes into the future to project the rain start/end forecast.
FORECAST_MIN=90

# Contact email sent in the User-Agent header for api.weather.gov lookups
# (NWS asks for this to identify API clients). Optional.
CONTACT_EMAIL=example@example.com
